[TEMPLATE]
[TEMPLATE]
# === MOMENT Backend Environment ===

# MongoDB
MONGODB_URI=mongodb://localhost:27017/moment

# JWT
JWT_SECRET=your-secret-key-here

# Server
PORT=5200
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5200

# Email — Brevo SMTP
# Get your SMTP key at: https://app.brevo.com/settings/keys/smtp
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-login@email.com
SMTP_PASS=your-brevo-smtp-key
SMTP_FROM="MOMENT <no-reply@moment.bj>"

# OpenAI (génération des questions du mini-jeu 🧠 Quiz)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Durée de validité des liens d'invitation (en minutes, défaut 1440 = 24h)
INVITE_LINK_TTL_MINUTES=1440

# Google Places API (optional — for importing venues)
GOOGLE_PLACES_API_KEY=

# Kkiapay (Mobile Money / CB — sandbox)
KKIAPAY_PUBLIC_KEY=
KKIAPAY_PRIVATE_KEY=
KKIAPAY_SECRET=
KKIAPAY_WEBHOOK_SECRET=

# Cloudinary (images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5200/api/auth/google/callback